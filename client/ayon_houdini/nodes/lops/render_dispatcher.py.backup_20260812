    def _check_group(self, title, list_widget):
        group = QtWidgets.QGroupBox(title)
        layout = QtWidgets.QVBoxLayout(group)
        layout.addWidget(list_widget)
        row = QtWidgets.QHBoxLayout()
        all_button = QtWidgets.QPushButton("All")
        none_button = QtWidgets.QPushButton("None")
        row.addWidget(all_button)
        row.addWidget(none_button)
        row.addStretch(1)
        layout.addLayout(row)
        all_button.clicked.connect(lambda: self._set_all(list_widget, True))
        none_button.clicked.connect(lambda: self._set_all(list_widget, False))
        return group

    @staticmethod
    def _set_all(list_widget, checked):
        state = QtCore.Qt.Checked if checked else QtCore.Qt.Unchecked
        for index in range(list_widget.count()):
            list_widget.item(index).setCheckState(state)

    @staticmethod
    def _add_check_item(list_widget, label, path, tooltip=""):
        item = QtWidgets.QListWidgetItem(label)
        item.setFlags(item.flags() | QtCore.Qt.ItemIsUserCheckable)
        item.setCheckState(QtCore.Qt.Checked)
        item.setData(QtCore.Qt.UserRole, path)
        item.setToolTip(tooltip or path)
        list_widget.addItem(item)

    def refresh(self):
        self.preflight = collect_preflight(self.node)
        self.aov_list.clear()
        self.pass_list.clear()
        for entry in self.preflight.aovs:
            tooltip = entry.path
            if entry.source_name and entry.source_name != entry.name:
                tooltip += "\nRender source: " + entry.source_name
            if entry.products:
                tooltip += "\nProducts: " + ", ".join(entry.products)
            self._add_check_item(self.aov_list, entry.name, entry.path, tooltip)
        for entry in self.preflight.passes:
            self._add_check_item(self.pass_list, entry.name, entry.path, entry.path)
        self.output_text.setPlainText(
            "\n".join(self.preflight.output_paths)
            or "<could not generate render output path>"
        )
        self.warning_label.setText("\n".join(self.preflight.warnings))
        self.warning_label.setVisible(bool(self.preflight.warnings))
        self.dispatch_button.setEnabled(
            bool(self.preflight.aovs and self.preflight.passes)
        )

    def _dispatch(self):
        selected_aovs = _checked_paths(self.aov_list)
        selected_passes = _checked_paths(self.pass_list)
        if not selected_aovs or not selected_passes:
            hou.ui.displayMessage(
                "Select at least one AOV and one render pass.",
                title="Render Dispatcher",
                severity=hou.severityType.Warning,
            )
            return
        self.dispatch_button.setEnabled(False)
        self.dispatch_button.setText("Submitting...")
        passes_by_path = {entry.path: entry for entry in self.preflight.passes}
        progress_entries = [
            passes_by_path[path] for path in selected_passes if path in passes_by_path
        ]
        self._progress_dialog = DispatchProgressDialog(progress_entries, parent=self)
        self._progress_dialog.show()
        self._progress_dialog.raise_()
        QtWidgets.QApplication.processEvents()
        try:
            submitted = dispatch_to_deadline(
                self.node,
                selected_aovs=selected_aovs,
                selected_passes=selected_passes,
                frame_start=self.frame_start.value(),
                frame_end=self.frame_end.value(),
                pool=self.pool.currentText(),
                group=self.group.currentText(),
                priority=self.priority.value(),
                chunk_size=self.chunk_size.value(),
                machine_limit=self.machine_limit.value(),
                job_prefix=self.job_prefix.text(),
                progress_callback=self._progress_dialog.update_progress,
            )
        except Exception as exc:
            _LOGGER.exception("Render dispatch failed")
            self._progress_dialog.mark_failed(str(exc))
        else:
            self._progress_dialog.finish()
        finally:
            self.dispatch_button.setText("Dispatch to Farm")
            self.dispatch_button.setEnabled(True)


def show_dispatcher(node_or_kwargs=None):
    """Run preflight and open the dispatcher dialog."""
    if QtWidgets is None:
        raise RuntimeError("Qt is unavailable; cannot open Render Dispatcher.")
    node = _resolve_node(node_or_kwargs)
    if node is None:
        raise RuntimeError("Could not resolve the Render Dispatcher node.")
    parent = hou.qt.mainWindow() if hasattr(hou, "qt") else None
    dialog = RenderDispatcherDialog(node, parent=parent)
    dialog.show()
    hou.session.ayon_render_dispatcher_dialog = dialog
    return dialog


def preflight(kwargs=None):
    """HDA button callback."""
    return show_dispatcher(kwargs)


def open_ui(kwargs=None):
    """Backward-compatible alias for older callback experiments."""
    return show_dispatcher(kwargs)


def dispatch(kwargs=None):
    """Backward-compatible callback; preflight is mandatory before dispatch."""
    return show_dispatcher(kwargs)
