@dataclass
class AovEntry:
    path: str
    name: str
    products: tuple[str, ...] = ()
    source_name: str = ""


@dataclass
class PassEntry:
    path: str
    name: str
    render_settings: str = ""
    is_render_pass: bool = True


@dataclass
class PreflightData:
    aovs: list[AovEntry] = field(default_factory=list)
    passes: list[PassEntry] = field(default_factory=list)
    output_paths: list[str] = field(default_factory=list)
    warnings: list[str] = field(default_factory=list)


def _require_houdini():
    if hou is None:
        raise RuntimeError("This operation must run inside Houdini.")


def _resolve_node(node_or_kwargs=None):
    """Resolve a Houdini node from callback kwargs, a node, or a path."""
    _require_houdini()
    if isinstance(node_or_kwargs, dict):
        node_or_kwargs = node_or_kwargs.get("node")
    if node_or_kwargs is None:
        return hou.pwd()
    if isinstance(node_or_kwargs, hou.Node):
        return node_or_kwargs
    if isinstance(node_or_kwargs, str):
        return hou.node(node_or_kwargs)
    return None


def _resolve_stage(node):
    """Resolve a stage from a LOP node, a referenced LOP, or an input."""
    if not node:
        return None
    stage_method = getattr(node, "stage", None)
    if callable(stage_method):
        try:
            stage = stage_method()
            if stage:
                return stage
        except Exception:
            pass

    for parm_name in ("loppath", "lop_path", "lopnode", "source_lop"):
        parm = node.parm(parm_name)
        if not parm:
            continue
        try:
            lop_node = parm.evalAsNode()
        except Exception:
            lop_node = None
        if lop_node:
            stage = _resolve_stage(lop_node)
            if stage:
                return stage

    try:
        inputs = node.inputs()
    except Exception:
        inputs = ()
    for input_node in inputs:
        if input_node:
            stage = _resolve_stage(input_node)
            if stage:
                return stage
    return None


def _prim_path(prim):
    return prim.GetPath().pathString


def _relationship_targets(prim, name):
    relationship = prim.GetRelationship(name)
    if not relationship:
        return []
    try:
        return [target.pathString for target in relationship.GetTargets()]
    except Exception:
        return []


def _attribute_string(prim, names):
    for name in names:
        attribute = prim.GetAttribute(name)
        if not attribute:
            continue
        try:
            value = attribute.Get()
        except Exception:
            value = None
        if value not in (None, ""):
            return str(value)
    return ""


def _friendly_aov_name(prim):
    """Return the exact USD RenderVar prim name without presentation changes."""
    return str(prim.GetName() or "")


def inspect_stage(stage) -> PreflightData:
    """Return the render work that the supplied USD stage will produce."""
    data = PreflightData()
    if stage is None:
        data.warnings.append("No USD stage is connected to the dispatcher.")
        return data

    render_vars = {}
    render_settings = []
    render_passes = []
    product_to_vars = {}

    try:
        prims = list(stage.Traverse())
    except Exception as exc:
        data.warnings.append("Could not traverse the USD stage: {}".format(exc))
        return data

    for prim in prims:
        if not prim or not prim.IsValid():
            continue
        type_name = prim.GetTypeName() or ""
        path = _prim_path(prim)
        if type_name == "RenderVar":
            render_vars[path] = (
                _friendly_aov_name(prim),
                _attribute_string(prim, ("sourceName",)),
            )
        elif type_name == "RenderProduct":
            targets = _relationship_targets(prim, "orderedVars")
            product_to_vars[path] = targets
            output = _attribute_string(
                prim,
                (
                    "productName",
                    "driver:parameters:aov:filename",
                    "ri:display:filename",
                ),
            )
            if output:
                data.output_paths.append(output)
        elif type_name == "RenderSettings":
            render_settings.append(path)
        elif type_name == "RenderPass":
            render_passes.append(prim)

    used_var_paths = []
    products_by_var = {}
    for product_path, var_paths in product_to_vars.items():
        for var_path in var_paths:
            if var_path not in used_var_paths:
                used_var_paths.append(var_path)
            products_by_var.setdefault(var_path, []).append(product_path)

    # An orderedVars relationship is the authoritative list of AOVs that will
    # render.  Older/custom render products may not author it, so fall back to
    # all RenderVars only when no product provides a relationship.
    if not used_var_paths:
        used_var_paths = sorted(render_vars)
    for path in used_var_paths:
        name, source_name = render_vars.get(
            path, (path.rsplit("/", 1)[-1], "")
        )
        data.aovs.append(
            AovEntry(
                path,
                name,
                tuple(sorted(products_by_var.get(path, ()))),
                source_name,
            )
        )

    for prim in sorted(render_passes, key=lambda item: _prim_path(item)):
        path = _prim_path(prim)
        source_targets = _relationship_targets(prim, "renderSource")
        render_settings_path = ""
        if source_targets:
            render_settings_path = source_targets[0]
        elif render_settings:
            # Custom/older RenderPass prims may omit renderSource.  The BMFX
            # graph has one shared RenderSettings prim in that case.
            render_settings_path = sorted(render_settings)[0]
        data.passes.append(
            PassEntry(
                path=path,
                name=prim.GetName(),
                render_settings=render_settings_path,
                is_render_pass=True,
            )
        )

    # RenderSettings are still valid jobs in scenes that do not use the newer
    # UsdRender.Pass schema.  Present them as passes so the workflow remains
    # useful for the current BMFX Render Setting HDA too.
    if not data.passes:
        for path in sorted(render_settings):
            data.passes.append(
                PassEntry(
                    path=path,
                    name=path.rsplit("/", 1)[-1],
                    render_settings=path,
                    is_render_pass=False,
                )
            )

    data.aovs.sort(key=lambda item: (item.name.lower(), item.path))
    data.output_paths = sorted(dict.fromkeys(data.output_paths))
    if not data.aovs:
        data.warnings.append("No connected RenderVars/AOVs were found.")
    if not data.passes:
        data.warnings.append("No RenderPass or RenderSettings prims were found.")
    if not data.output_paths:
        data.warnings.append("No RenderProduct output path was found.")
    return data


def _upstream_nodes(node):
    """Yield every connected upstream node once, nearest nodes first."""
    visited = set()
    try:
        pending = [item for item in node.inputs() if item is not None]
    except Exception:
        pending = []

    while pending:
        upstream = pending.pop(0)
        try:
            node_path = upstream.path()
        except Exception:
            continue
        if node_path in visited:
            continue
        visited.add(node_path)
        yield upstream

        try:
            pending.extend(item for item in upstream.inputs() if item is not None)
        except Exception:
            pass


def _render_preset_name(node):
    """Read the upstream BMFX Render Setting AOV preset."""
    preset_names = {
        "0": "Beauty",
        "1": "Utility",
        "2": "Lookdev",
        "3": "Matte",
        "4": "Hero",
        "beauty": "Beauty",
        "utility": "Utility",
        "lookdev": "Lookdev",
        "matte": "Matte",
        "hero": "Hero",
    }
    for upstream in _upstream_nodes(node):
        parm = upstream.parm("varType")
        if parm is None:
            continue
        try:
            value = str(parm.eval()).strip().lower()
        except Exception:
            try:
                value = parm.evalAsString().strip().lower()
            except Exception:
                value = ""
        if value in preset_names:
            return preset_names[value]
    return "Beauty"


def _context_render_root():
    """Build a render root using the same context layout as File Cache."""
    try:
        from ayon_houdini.nodes.lops import filecache

        root = filecache.project_root()
    except Exception:
        root = hou.expandString("$JOB")
        if not root or root == "$JOB":
            root = hou.expandString("$HIP")
    if not root:
        root = tempfile.gettempdir()

    try:
        from ayon_core.pipeline import get_current_context

        context = get_current_context() or {}
    except Exception:
        context = {}

    folder_path = (context.get("folder_path") or "").strip("/\\")
    if not folder_path:
        sequence = hou.expandString("$SEQ").strip("/\\")
        shot = hou.expandString("$SHOT").strip("/\\")
        context_parts = [
            value
            for value, unresolved in ((sequence, "$SEQ"), (shot, "$SHOT"))
            if value and value != unresolved
        ]
        folder_path = os.path.join(*context_parts) if context_parts else "unknown_folder"

    task_name = context.get("task_name") or ""
    if not task_name:
        task_name = hou.expandString("$TASK")
        if not task_name or task_name == "$TASK":
            task_name = "unknown_task"
    return os.path.join(root, folder_path, "houdini", task_name, "render")


def _render_product_root(node, pass_name):
    """Return the product root equivalent to File Cache's node_cache_root."""
    safe_pass = _safe_pass_name(pass_name) or "render_pass"
    preset_name = _render_preset_name(node)
    output_name = "{}-{}".format(safe_pass, preset_name)
    return os.path.join(_context_render_root(), output_name)


def _existing_render_versions(node, pass_name):
    """Return existing v### directories, matching File Cache behavior."""
    product_root = _render_product_root(node, pass_name)
    if not os.path.isdir(product_root):
        return []
    versions = []
    for directory_name in os.listdir(product_root):
        match = re.match(r"^v(\d+)$", directory_name)
        if match:
            versions.append(int(match.group(1)))
    return sorted(versions)


def _next_render_version(node, pass_name):
    """Always return the next version; render dispatch has no manual mode."""
    versions = _existing_render_versions(node, pass_name)
    return versions[-1] + 1 if versions else 1


def _render_version_dir(node, pass_name, version=None, create=False):
    if version is None:
        version = _next_render_version(node, pass_name)
    path = os.path.join(
        _render_product_root(node, pass_name),
        "v{:03d}".format(int(version)),
    )
    if create:
        os.makedirs(path, exist_ok=True)
    return path


def _generated_pass_output_path(node, pass_name, version=None):
    """Return the versioned dispatcher-owned EXR path for one render pass."""
    safe_pass = _safe_pass_name(pass_name) or "render_pass"
    preset_name = _render_preset_name(node)
    output_name = "{}-{}".format(safe_pass, preset_name)
    return os.path.join(
        _render_version_dir(node, pass_name, version=version),
        "{}.$F4.exr".format(output_name),
    ).replace("\\", "/")


def collect_preflight(node_or_kwargs=None) -> PreflightData:
    node = _resolve_node(node_or_kwargs)
    if node is None:
        return PreflightData(warnings=["Could not resolve the dispatcher node."])
    data = inspect_stage(_resolve_stage(node))
    data.output_paths = [
        _generated_pass_output_path(node, entry.name) for entry in data.passes
    ]
    data.warnings = [
        warning
        for warning in data.warnings
        if warning != "No RenderProduct output path was found."
    ]
    return data


def _json_parm(node, name):
    parm = node.parm(name) if node else None
    if parm is None:
        return []
    try:
        value = json.loads(parm.evalAsString() or "[]")
    except (TypeError, ValueError):
        return []
    return [str(item) for item in value] if isinstance(value, list) else []


def cook_dispatcher_stage(python_lop=None, settings_node=None):
    """Filter RenderProduct AOVs and RenderPasses on the editable stage.

    This is the script called by the Python LOP inside the generated HDA.  In
    ordinary interactive use filtering is off, making the HDA a true pass-through.
    It is enabled only in the HIP snapshots produced for farm jobs.
    """
    _require_houdini()
    python_lop = python_lop or hou.pwd()
    settings_node = settings_node or python_lop.parent()
    active_parm = settings_node.parm(_FILTER_ACTIVE_PARM)
    if active_parm is None or not bool(active_parm.eval()):
        return

    selected_aovs = set(_json_parm(settings_node, _SELECTED_AOVS_PARM))
    selected_passes = set(_json_parm(settings_node, _SELECTED_PASSES_PARM))
    stage = python_lop.editableStage()
    if stage is None:
        raise RuntimeError("Render Dispatcher could not acquire an editable stage.")

    for prim in stage.Traverse():
        type_name = prim.GetTypeName() or ""
        if type_name == "RenderProduct":
            relationship = prim.GetRelationship("orderedVars")
            if relationship:
                targets = relationship.GetTargets()
                relationship.SetTargets(
                    [target for target in targets if target.pathString in selected_aovs]
                )
        elif type_name == "RenderPass" and selected_passes:
            if _prim_path(prim) not in selected_passes:
                prim.SetActive(False)


def _deadline_values(kind):
    command = shutil.which("deadlinecommand")
    argument = _DEADLINE_COMMANDS.get(kind)
    if not command or not argument:
        return []
    try:
        output = subprocess.check_output(
            [command, argument], stderr=subprocess.STDOUT, timeout=8
        ).decode(errors="replace")
    except (OSError, subprocess.CalledProcessError, subprocess.TimeoutExpired):
        return []
    values = []
    for line in re.split(r"[\r\n,]+", output):
        value = line.strip()
        if not value or value.lower().startswith(("result", "success", "error")):
            continue
        if value not in values:
            values.append(value)
    return values


def _set_first_parm(node, names, value, required=False):
    for name in names:
        parm = node.parm(name)
        if parm is not None:
            parm.set(value)
            return name
    if required:
        raise RuntimeError(
            "{} has none of the required parameters: {}".format(
                node.path(), ", ".join(names)
            )
        )
    return None


def _set_output_override(rop, output_path):
    """Set and verify USD Render ROP's Override Output Image parameter."""
    parm = rop.parm("outputimage")
    if parm is None:
        raise RuntimeError(
            "USD Render ROP {} has no outputimage parameter.".format(rop.path())
        )
    parm.deleteAllKeyframes()
    parm.set(output_path)
    try:
        saved_value = parm.unexpandedString()
    except Exception:
        saved_value = parm.evalAsString()
    if saved_value != output_path:
        raise RuntimeError(
            "Failed to set Override Output Image on {}. Expected {!r}, got {!r}.".format(
                rop.path(), output_path, saved_value
            )
        )
    return saved_value


def _set_renderman_ris_delegate(rop):
    """Select RenderMan RIS explicitly on a USD Render ROP."""
    renderer_parm = rop.parm("renderer")
    if renderer_parm is None:
        raise RuntimeError("USD Render ROP has no renderer parameter.")
    try:
        renderer_info = list(hou.lop.availableRendererInfo())
    except Exception:
        renderer_info = []

    renderer_name = ""
    for info in renderer_info:
        name = str(info.get("name") or "")
        display_name = str(info.get("displayname") or "")
        if display_name.strip().lower() == "renderman ris":
            renderer_name = name
            break
        if name == "HdPrmanLoaderRendererPlugin":
            renderer_name = name

    # This is the canonical token behind the RenderMan RIS menu entry.  Keep
    # it as a fallback because the dynamic menu may populate only after RFH
    # finishes initializing, while the token itself is still valid.
    renderer_name = renderer_name or "HdPrmanLoaderRendererPlugin"
    renderer_parm.set(renderer_name)
    if renderer_parm.evalAsString() != renderer_name:
        raise RuntimeError(
            "Failed to set RenderMan delegate on {}.".format(rop.path())
        )
    return renderer_name


def _safe_pass_name(name):
    return re.sub(r"[^A-Za-z0-9_.-]+", "_", str(name or "")).strip("_")


def _create_usd_render_rop(
    dispatcher_node,
    pass_entry,
    frame_start,
    frame_end,
    output_path="",
):
    out = hou.node("/out")
    if out is None:
        raise RuntimeError("Houdini has no /out network for the farm render ROP.")

    rop = None
    errors = []
    for type_name in ("usdrender", "usd_rop", "karma"):
        try:
            rop = out.createNode(
                type_name,
                "ayon_dispatch_{}".format(uuid.uuid4().hex[:8]),
            )
            break
        except hou.OperationFailed as exc:
            errors.append("{}: {}".format(type_name, exc))
    if rop is None:
        raise RuntimeError(
            "Could not create a USD Render ROP. Tried: {}".format("; ".join(errors))
        )

    try:
        _set_first_parm(
            rop,
            ("loppath", "lop_path", "lopnode"),
            dispatcher_node.path(),
            required=True,
        )
        if pass_entry.render_settings:
            _set_first_parm(
                rop,
                ("rendersettings", "render_settings", "rendersettingsprim"),
                pass_entry.render_settings,
                required=True,
            )
        if pass_entry.is_render_pass:
            _set_first_parm(
                rop,
                (
                    "renderpass",
                    "render_pass",
                    "renderpassprim",
                    "renderpasspath",
                ),
                pass_entry.path,
                required=True,
            )
        if output_path:
            _set_output_override(rop, output_path)
        _set_renderman_ris_delegate(rop)
        _set_first_parm(rop, ("runcommand",), 1)
        _set_first_parm(rop, ("allframesatonce",), 0)
        _set_first_parm(rop, ("trange",), 1)
        if rop.parmTuple("f"):
            rop.parmTuple("f").set((frame_start, frame_end, 1))
        else:
            _set_first_parm(rop, ("f1", "startframe"), frame_start)
            _set_first_parm(rop, ("f2", "endframe"), frame_end)
        return rop
    except Exception:
        rop.destroy()
        raise


def _pipeline_environment():
    """Return farm paths with the local ``ayon_houdini`` parent guaranteed."""
    environment = {
        key: os.environ[key]
        for key in ("PYTHONPATH", "HOUDINI_PATH", "HOUDINI_OTLSCAN_PATH")
        if os.environ.get(key)
    }

    # render_dispatcher.py -> lops -> nodes -> ayon_houdini -> import parent.
    package_parent = os.path.dirname(
        os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
    )
    python_paths = [
        value
        for value in environment.get("PYTHONPATH", "").split(os.pathsep)
        if value
    ]
    normalized = {os.path.normcase(os.path.normpath(value)) for value in python_paths}
    normalized_parent = os.path.normcase(os.path.normpath(package_parent))
    if normalized_parent not in normalized:
        python_paths.insert(0, package_parent)
    environment["PYTHONPATH"] = os.pathsep.join(python_paths)
    return environment


def _renderer_environment():
    """Collect RenderMan/RFH variables required before the ROP initializes."""
    exact_names = {
        "RFHTREE",
        "RMANTREE",
        "PATH",
        "LD_LIBRARY_PATH",
    }
    prefixes = ("RFH_", "RMAN_", "PXR_")
    environment = {
        key: value
        for key, value in os.environ.items()
        if value and (key in exact_names or key.startswith(prefixes))
    }

    # Houdini packages can define variables in the Houdini environment without
    # reflecting all of them in Python's os.environ.  RFH is commonly loaded
    # this way, so collect the hscript environment as well.
    try:
        raw_variables = hou.hscript("set")[0]
    except Exception:
        raw_variables = ""
    for line in raw_variables.splitlines():
        if "=" not in line:
            continue
        key, value = line.split("=", 1)
        key = key.strip()
        if key not in exact_names and not key.startswith(prefixes):
            continue
        value = hou.expandString(value.strip())
        if value:
            environment[key] = value

    # Last-resort recovery for sessions where the RFH package expanded
    # HOUDINI_PATH but did not expose RFHTREE to Python.  This exact situation
    # otherwise produces `(null)/<py>/<houdini>/lib/rfh_batch.so` on Deadline.
    if not environment.get("RFHTREE"):
        houdini_path = os.environ.get("HOUDINI_PATH", "")
        if not houdini_path:
            try:
                houdini_path = hou.getenv("HOUDINI_PATH") or ""
            except Exception:
                houdini_path = ""
        pattern = re.compile(
            r"^(?P<root>.+/RenderManForHoudini-(?P<version>[^/]+))"
            r"/(?P<python>[^/]+)/(?P<houdini>[^/]+)$"
        )
        for entry in houdini_path.split(os.pathsep):
            match = pattern.match(entry.rstrip("/"))
            if not match:
                continue
            environment["RFHTREE"] = match.group("root")
            environment.setdefault("RFH_PY_VERS", match.group("python"))
            environment.setdefault("RFH_HOUDINI_VERS", match.group("houdini"))
            server_root = os.path.join(
                os.path.dirname(match.group("root")),
                "RenderManProServer-{}".format(match.group("version")),
            )
            if os.path.isdir(server_root):
                environment.setdefault("RMANTREE", server_root)
            break
    return environment


def _farm_environment():
    environment = _pipeline_environment()
    environment.update(_renderer_environment())
    return environment


def _write_ayon_context(root):
    """Write the same farm bootstrap payload as the LOP File Cache."""
    path = os.path.join(root, ".ayon_vars.json")
    try:
        from ayon_houdini.nodes.lops import filecache

        payload = {
            "launcher_env": filecache.get_ayon_launcher_env(),
            "houdini_vars": filecache.filter_custom_houdini_vars(
                filecache.get_all_houdini_vars()
            ),
            "pipeline_env": _farm_environment(),
        }
        payload["houdini_vars"].update(_renderer_environment())
    except Exception:
        launcher_env = {
            key: value
            for key, value in os.environ.items()
            if key.startswith(("AYON_", "OPENPYPE_", "AVALON_"))
        }
        houdini_vars = {}
        try:
            raw_variables = hou.hscript("set")[0]
            allowed_exact = {"JOB", "SEQ", "SHOT", "APP", "LIB"}
            allowed_prefixes = (
                "AYON_",
                "OPENPYPE_",
                "AVALON_",
                "TH_",
                "RES",
                "PIX_",
            )
            for line in raw_variables.splitlines():
                if "=" not in line:
                    continue
                key, value = line.split("=", 1)
                key = key.strip()
                if key in allowed_exact or key.startswith(allowed_prefixes):
                    houdini_vars[key] = hou.expandString(value.strip())
        except Exception:
            pass
        payload = {
            "launcher_env": launcher_env,
            "houdini_vars": houdini_vars,
            "pipeline_env": _farm_environment(),
        }
    with open(path, "w") as stream:
        json.dump(payload, stream, indent=2, sort_keys=True)
    return path


def _add_pipeline_environment(job_info, start_index=1):
    """Put import/HDA paths in the process environment before Houdini starts."""
    index = int(start_index)
    for key, value in _farm_environment().items():
        job_info["EnvironmentKeyValue{}".format(index)] = "{}={}".format(
            key, value
        )
        index += 1
    return job_info


def _save_snapshot(path):
    normalized = path.replace("\\", "/").replace('"', '\\"')
    hou.hscript('mwrite -n "{}"'.format(normalized))


def _write_info_file(root, stem, values):
    path = os.path.join(root, stem)
    with open(path, "w") as stream:
        for key, value in values.items():
            if value not in (None, ""):
                stream.write("{}={}\n".format(key, value))
    return path


def _submit_deadline_files(command, job_path, plugin_path):
    try:
        output = subprocess.check_output(
            [command, job_path, plugin_path], stderr=subprocess.STDOUT
        ).decode(errors="replace")
    except subprocess.CalledProcessError as exc:
        message = exc.output.decode(errors="replace") if exc.output else str(exc)
        raise RuntimeError("Deadline submission failed:\n{}".format(message.strip()))
    match = re.search(r"JobID=([^\s]+)", output)
    if not match:
        raise RuntimeError("Deadline returned no JobID:\n{}".format(output.strip()))
    return match.group(1)
    

def _remove_submission_info_files(*paths):
    """Match File Cache by not retaining temporary Deadline info files."""
    for path in paths:
        try:
            os.unlink(path)
        except OSError:
            pass


def dispatch_to_deadline(
    node_or_kwargs,
    selected_aovs,
    selected_passes,
    frame_start,
    frame_end,
    pool="houdini",
    group="",
    priority=50,
    chunk_size=10,
    machine_limit=0,
    job_prefix="",
    progress_callback=None,
):
    """Submit one filtered HIP snapshot per selected pass to Deadline."""
    node = _resolve_node(node_or_kwargs)
    if node is None:
        raise RuntimeError("Could not resolve the Render Dispatcher node.")
    deadline_command = shutil.which("deadlinecommand")
    if not deadline_command:
        raise RuntimeError("deadlinecommand was not found in PATH.")

    preflight = collect_preflight(node)
    passes_by_path = {entry.path: entry for entry in preflight.passes}
    selected_pass_entries = [
        passes_by_path[path] for path in selected_passes if path in passes_by_path
    ]
    known_aovs = {entry.path for entry in preflight.aovs}
    selected_aovs = [path for path in selected_aovs if path in known_aovs]
    if not selected_pass_entries:
        raise RuntimeError("Select at least one render pass.")
    if not selected_aovs:
        raise RuntimeError("Select at least one AOV.")

    frame_start = int(frame_start)
    frame_end = int(frame_end)
    if frame_end < frame_start:
        raise ValueError("Frame end must be greater than or equal to frame start.")
    priority = max(0, min(100, int(priority)))
    chunk_size = max(1, int(chunk_size))
    machine_limit = max(0, int(machine_limit))

    hidden_parms = {
        name: node.parm(name).eval()
        for name in (_FILTER_ACTIVE_PARM, _SELECTED_AOVS_PARM, _SELECTED_PASSES_PARM)
        if node.parm(name) is not None
    }
    submitted = []
    rops = []
    try:
        node.parm(_FILTER_ACTIVE_PARM).set(1)
        node.parm(_SELECTED_AOVS_PARM).set(json.dumps(selected_aovs))
        total_passes = len(selected_pass_entries)
        for pass_index, pass_entry in enumerate(selected_pass_entries):
            _notify_dispatch_progress(
                progress_callback, pass_entry, pass_index, total_passes,
                "Preparing", 10
            )
            node.parm(_SELECTED_PASSES_PARM).set(json.dumps([pass_entry.path]))
            node.cook(force=True)
            version = _next_render_version(node, pass_entry.name)
            version_root = _render_version_dir(
                node, pass_entry.name, version=version, create=True
            )
            pass_output_path = _generated_pass_output_path(
                node, pass_entry.name, version=version
            )
            os.makedirs(os.path.dirname(pass_output_path), exist_ok=True)
            context_path = _write_ayon_context(version_root)
            rop = _create_usd_render_rop(
                node,
                pass_entry,
                frame_start,
                frame_end,
                output_path=pass_output_path,
            )
            rops.append(rop)

            _notify_dispatch_progress(
                progress_callback, pass_entry, pass_index, total_passes,
                "Saving Farm Scene", 45, version=version
            )
            hip_root = os.path.join(version_root, "hip")
            os.makedirs(hip_root, exist_ok=True)
            hip_path = os.path.join(hip_root, "source.hip")
            _save_snapshot(hip_path)

            display_name = "{} | {} | v{:03d}".format(
                job_prefix.strip() or node.name(), pass_entry.name, version
            )
            job_info = {
                "Plugin": "Houdini",
                "BatchName": job_prefix.strip() or node.name(),
                "Name": display_name,
                "Frames": "{}-{}".format(frame_start, frame_end),
                "ChunkSize": chunk_size,
                "Pool": pool.strip(),
                "Group": group.strip(),
                "Priority": priority,
                "EnvironmentKeyValue0": "AYON_CONTEXT_JSON={}".format(context_path),
                "EnvironmentKeyValue1": "BMFX_RENDER_VERSION={}".format(version),
                "MachineLimit": machine_limit or None,
                "OutputFilename0": pass_output_path or None,
            }
            _add_pipeline_environment(job_info, start_index=2)
            application_version = hou.applicationVersion()
            plugin_info = {
                "SceneFile": hip_path,
                "OutputDriver": rop.path(),
                "Version": "{}.{}".format(
                    application_version[0], application_version[1]
                ),
                "Build": "64bit",
                "IgnoreSceneFileFrameRange": True,
                "StartFrame": frame_start,
                "EndFrame": frame_end,
            }
            job_path = _write_info_file(
                version_root, "deadline_job.info", job_info
            )
            plugin_path = _write_info_file(
                version_root, "deadline_plugin.info", plugin_info
            )
            _notify_dispatch_progress(
                progress_callback, pass_entry, pass_index, total_passes,
                "Submitting to Farm", 75, version=version
            )
            try:
                job_id = _submit_deadline_files(
                    deadline_command, job_path, plugin_path
                )
            finally:
                _remove_submission_info_files(job_path, plugin_path)
            submitted.append((pass_entry.path, job_id))
            _notify_dispatch_progress(
                progress_callback, pass_entry, pass_index, total_passes,
                "Submitted on Farm", 100, version=version, job_id=job_id
            )
            _LOGGER.info("Submitted %s as Deadline job %s", pass_entry.path, job_id)
    finally:
        for rop in rops:
            try:
                rop.destroy()
            except Exception:
                pass
        for name, value in hidden_parms.items():
            parm = node.parm(name)
            if parm is not None:
                parm.set(value)
        try:
            node.cook(force=True)
        except Exception:
            pass
    return submitted


def _notify_dispatch_progress(
    callback, pass_entry, pass_index, total_passes, status, progress,
    version=None, job_id=""
):
    """Send a UI progress update without making UI errors fail a farm job."""
    if callback is None:
        return
    try:
        callback(
            pass_path=pass_entry.path,
            pass_name=pass_entry.name,
            pass_index=pass_index,
            total_passes=total_passes,
            status=status,
            progress=progress,
            version=version,
            job_id=job_id,
        )
    except Exception:
        _LOGGER.exception("Could not update the Render Dispatcher progress UI")


def _checked_paths(list_widget):
    result = []
    for index in range(list_widget.count()):
        item = list_widget.item(index)
        if item.checkState() == QtCore.Qt.Checked:
            result.append(item.data(QtCore.Qt.UserRole))
    return result


class DispatchProgressDialog(QtWidgets.QDialog if QtWidgets is not None else object):
    """Live progress for the current batch of Deadline submissions."""

    _STATUS_COLORS = {
        "Queued": "#8f98a3",
        "Preparing": "#70b9ed",
        "Saving Farm Scene": "#e0b15b",
        "Submitting to Farm": "#ef944d",
        "Submitted on Farm": "#55c68c",
        "Failed": "#ef6b73",
    }

    def __init__(self, pass_entries, parent=None):
        super(DispatchProgressDialog, self).__init__(parent)
        self.pass_entries = list(pass_entries)
        self.rows = {}
        self.active_path = ""
        self.setWindowTitle("Render Dispatcher - Farm Submission")
        self.setMinimumSize(720, 360)
        self.resize(820, max(420, 220 + len(self.pass_entries) * 38))
        self.setStyleSheet(_DISPATCHER_STYLE)
        self._build_ui()

    def _build_ui(self):
        layout = QtWidgets.QVBoxLayout(self)
        layout.setContentsMargins(20, 18, 20, 18)
        layout.setSpacing(12)

        title = QtWidgets.QLabel("FARM SUBMISSION")
        title.setObjectName("titleLabel")
        subtitle = QtWidgets.QLabel(
            "Preparing one versioned scene and Deadline job for each render pass."
        )
        subtitle.setObjectName("subtitleLabel")
        layout.addWidget(title)
        layout.addWidget(subtitle)

        self.table = QtWidgets.QTableWidget(len(self.pass_entries), 4)
        self.table.setHorizontalHeaderLabels(
            ["Render Pass", "Version", "Status", "Progress"]
        )
        self.table.verticalHeader().setVisible(False)
        self.table.setSelectionMode(QtWidgets.QAbstractItemView.NoSelection)
        self.table.setEditTriggers(QtWidgets.QAbstractItemView.NoEditTriggers)
        self.table.setAlternatingRowColors(True)
        header = self.table.horizontalHeader()
        header.setSectionResizeMode(0, QtWidgets.QHeaderView.Stretch)
        header.setSectionResizeMode(1, QtWidgets.QHeaderView.ResizeToContents)
        header.setSectionResizeMode(2, QtWidgets.QHeaderView.ResizeToContents)
        header.setSectionResizeMode(3, QtWidgets.QHeaderView.Stretch)

        for row, entry in enumerate(self.pass_entries):
            name_item = QtWidgets.QTableWidgetItem(entry.name)
            name_item.setToolTip(entry.path)
            version_item = QtWidgets.QTableWidgetItem("-")
            status_item = QtWidgets.QTableWidgetItem("Queued")
            status_item.setForeground(QtGui.QColor(self._STATUS_COLORS["Queued"]))
            progress = QtWidgets.QProgressBar()
            progress.setRange(0, 100)
            progress.setValue(0)
            progress.setFormat("Queued")
            self.table.setItem(row, 0, name_item)
            self.table.setItem(row, 1, version_item)
            self.table.setItem(row, 2, status_item)
            self.table.setCellWidget(row, 3, progress)
            self.rows[entry.path] = (row, progress)
        layout.addWidget(self.table, 1)

        self.summary = QtWidgets.QLabel(
            "0 of {} passes submitted".format(len(self.pass_entries))
        )
        self.summary.setObjectName("summaryLabel")
        self.overall_progress = QtWidgets.QProgressBar()
        self.overall_progress.setRange(0, 100)
        self.overall_progress.setValue(0)
        self.overall_progress.setFormat("Overall progress  %p%")
        layout.addWidget(self.summary)
        layout.addWidget(self.overall_progress)

        button_row = QtWidgets.QHBoxLayout()
        button_row.addStretch(1)
        self.close_button = QtWidgets.QPushButton("Close")
        self.close_button.setObjectName("closeButton")
        self.close_button.setEnabled(False)
        self.close_button.clicked.connect(self.close)
        button_row.addWidget(self.close_button)
        layout.addLayout(button_row)

    def update_progress(
        self, pass_path, pass_name, pass_index, total_passes, status,
        progress, version=None, job_id=""
    ):
        row_data = self.rows.get(pass_path)
        if row_data is None:
            return
        self.active_path = pass_path
        row, progress_bar = row_data
        if version is not None:
            self.table.item(row, 1).setText("v{:03d}".format(int(version)))
        status_item = self.table.item(row, 2)
        status_item.setText(status)
        color = self._STATUS_COLORS.get(status, "#e7e9ec")
        status_item.setForeground(QtGui.QColor(color))
        progress_bar.setValue(int(progress))
        progress_bar.setFormat("{}%".format(int(progress)))
        if job_id:
            status_item.setToolTip("Deadline accepted this submission.")

        completed = sum(
            1 for _, bar in self.rows.values() if bar.value() >= 100
        )
        total_progress = sum(bar.value() for _, bar in self.rows.values())
        total_progress = int(total_progress / max(1, len(self.rows)))
        self.overall_progress.setValue(total_progress)
        self.summary.setText(
            "{} of {} passes submitted".format(completed, total_passes)
        )
        QtWidgets.QApplication.processEvents()

    def mark_failed(self, message):
        if self.active_path in self.rows:
            row, progress_bar = self.rows[self.active_path]
            item = self.table.item(row, 2)
            item.setText("Failed")
            item.setForeground(QtGui.QColor(self._STATUS_COLORS["Failed"]))
            item.setToolTip(message)
            progress_bar.setFormat("Failed")
        self.summary.setText("Submission stopped: {}".format(message))
        self.summary.setStyleSheet("color: #ef6b73;")
        self.close_button.setEnabled(True)
        QtWidgets.QApplication.processEvents()

    def finish(self):
        total = len(self.pass_entries)
        self.overall_progress.setValue(100)
        self.summary.setText(
            "{} of {} passes submitted to farm".format(total, total)
        )
        self.summary.setStyleSheet("color: #55c68c;")
        self.close_button.setEnabled(True)
        QtWidgets.QApplication.processEvents()


