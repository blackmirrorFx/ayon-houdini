        layout = QtWidgets.QVBoxLayout(group)
        layout.setContentsMargins(12, 14, 12, 10)
        layout.setSpacing(6)
        if context_widget is not None:
            layout.addWidget(context_widget)
        if search_widget is not None:
            layout.addWidget(search_widget)
        # Give the list all expandable space and keep its action row anchored
        # below the list, matching the Render Pass controls.
        layout.addWidget(list_widget)
        row = QtWidgets.QHBoxLayout()
        all_button = QtWidgets.QPushButton("All")
        none_button = QtWidgets.QPushButton("None")
        row.addWidget(all_button)
        row.addWidget(none_button)
        for button in extra_buttons or ():
            row.addWidget(button)
        row.addStretch(1)
        layout.addLayout(row)
        all_button.clicked.connect(lambda: self._set_all(list_widget, True))
        none_button.clicked.connect(lambda: self._set_all(list_widget, False))
        return group

    @staticmethod
    def _set_all(list_widget, checked):
        state = QtCore.Qt.Checked if checked else QtCore.Qt.Unchecked
        for index in range(list_widget.count()):
            item = list_widget.item(index)
            if item.data(QtCore.Qt.UserRole) is not None:
                item.setCheckState(state)

    @staticmethod
    def _add_check_item(list_widget, label, path, tooltip=""):
        item = QtWidgets.QListWidgetItem(label)
        item.setFlags(item.flags() | QtCore.Qt.ItemIsUserCheckable)
        item.setCheckState(QtCore.Qt.Checked)
        item.setData(QtCore.Qt.UserRole, path)
        item.setToolTip(tooltip or path)
        list_widget.addItem(item)

    def refresh(self):
        self.preflight = collect_preflight(self.node)
        self.aov_list.clear()
        self.pass_list.clear()
        self.pass_aov_selections = {
            entry.path: _default_aov_paths(self.preflight.aovs, entry.preset)
            for entry in self.preflight.passes
        }
        self._populate_aov_list()
        for entry in self.preflight.passes:
            self._add_check_item(self.pass_list, entry.name, entry.path, entry.path)
        if self.pass_list.count():
            self.pass_list.setCurrentRow(0)
        self._populate_output_preview()
        self._update_validation()

    def _populate_aov_list(self):
        self._loading_aovs = True
        self.aov_list.clear()
        categories = ("Beauty", "Lighting", "Utility", "Cryptomatte", "Deep", "Custom")
        for category in categories:
            entries = [entry for entry in self.preflight.aovs if entry.category == category]
            if not entries:
                continue
            heading = QtWidgets.QListWidgetItem(category.upper())
            heading.setData(QtCore.Qt.UserRole + 1, category)
            heading.setForeground(QtGui.QColor("#70b9ed"))
            font = heading.font()
            font.setBold(True)
            heading.setFont(font)
            heading.setFlags(QtCore.Qt.NoItemFlags)
            self.aov_list.addItem(heading)
            for entry in entries:
                tooltip = entry.path
                if entry.source_name and entry.source_name != entry.name:
                    tooltip += "\nRender source: " + entry.source_name
                if entry.products:
                    tooltip += "\nProducts: " + ", ".join(entry.products)
                self._add_check_item(self.aov_list, entry.name, entry.path, tooltip)
                item = self.aov_list.item(self.aov_list.count() - 1)
                item.setData(QtCore.Qt.UserRole + 1, category)
        self._loading_aovs = False

    def _populate_output_preview(self):
        self.output_table.setRowCount(len(self.preflight.passes))
        for row, entry in enumerate(self.preflight.passes):
            category = _normalized_pass_preset(entry.preset)
            version = _next_render_version(
                self.node, entry.name, preset_name=category
            )
            output = _generated_pass_output_path(
                self.node,
                entry.name,
                version=version,
                preset_name=category,
            )
            values = (entry.name, category, "v{:03d}".format(version), output)
            for column, value in enumerate(values):
                item = QtWidgets.QTableWidgetItem(value)
                item.setToolTip(value)
                self.output_table.setItem(row, column, item)

    def _on_pass_current_changed(self, current, previous):
        path = current.data(QtCore.Qt.UserRole) if current is not None else ""
        self._active_pass_path = path or ""
        selected = self.pass_aov_selections.get(self._active_pass_path, set())
        self._loading_aovs = True
        for index in range(self.aov_list.count()):
            item = self.aov_list.item(index)
            aov_path = item.data(QtCore.Qt.UserRole)
            if aov_path is not None:
                item.setCheckState(
                    QtCore.Qt.Checked if aov_path in selected else QtCore.Qt.Unchecked
                )
        self._loading_aovs = False

    def _on_aov_item_changed(self, item):
        if self._loading_aovs or not self._active_pass_path:
            return
        path = item.data(QtCore.Qt.UserRole)
        if path is None:
            return
        selected = self.pass_aov_selections.setdefault(self._active_pass_path, set())
        if item.checkState() == QtCore.Qt.Checked:
            selected.add(path)
        else:
            selected.discard(path)

    def _copy_aovs_to_all_passes(self):
        if not self._active_pass_path:
            return
        selected = set(self.pass_aov_selections.get(self._active_pass_path, set()))
        for pass_path in self.pass_aov_selections:
            self.pass_aov_selections[pass_path] = set(selected)

    def _set_aov_preset(self, preset):
        essential_tokens = ("beauty", "rgba", "normal", "depth", "crypto")
        self._loading_aovs = True
        for index in range(self.aov_list.count()):
            item = self.aov_list.item(index)
            path = item.data(QtCore.Qt.UserRole)
            if path is None:
                continue
            category = item.data(QtCore.Qt.UserRole + 1)
            name = item.text().lower()
            if preset == "beauty":
                checked = category in ("Beauty", "Lighting")
            elif preset == "utility":
                checked = category in ("Utility", "Cryptomatte", "Deep")
            else:
                checked = any(token in name for token in essential_tokens)
            item.setCheckState(QtCore.Qt.Checked if checked else QtCore.Qt.Unchecked)
        self._loading_aovs = False
        if self._active_pass_path:
            self.pass_aov_selections[self._active_pass_path] = set(
                _checked_paths(self.aov_list)
            )

    def _filter_aovs(self, text):
        query = text.strip().lower()
        visible_categories = set()
        for index in range(self.aov_list.count()):
            item = self.aov_list.item(index)
            if item.data(QtCore.Qt.UserRole) is None:
                continue
            visible = not query or query in item.text().lower()
            item.setHidden(not visible)
            if visible:
                visible_categories.add(item.data(QtCore.Qt.UserRole + 1))
        for index in range(self.aov_list.count()):
            item = self.aov_list.item(index)
            if item.data(QtCore.Qt.UserRole) is None:
                item.setHidden(item.data(QtCore.Qt.UserRole + 1) not in visible_categories)

    def _filter_passes(self, text):
        query = text.strip().lower()
        for index in range(self.pass_list.count()):
            item = self.pass_list.item(index)
            item.setHidden(bool(query and query not in item.text().lower()))

    def _update_validation(self):
        issues = validate_preflight(
            self.node,
            self.preflight,
            self.frame_start.value(),
            self.frame_end.value(),
        )
        colors = {"ok": "#55c68c", "warning": "#e0b15b", "error": "#ef6b73"}
        symbols = {"ok": "OK", "warning": "WARNING", "error": "ERROR"}
        self.validation_list.clear()
        for severity, message in issues:
            item = QtWidgets.QListWidgetItem(
                "{}  {}".format(symbols.get(severity, "INFO"), message)
            )
            item.setForeground(QtGui.QColor(colors.get(severity, "#e7e9ec")))
            self.validation_list.addItem(item)
        self.dispatch_button.setEnabled(not any(level == "error" for level, _ in issues))

    def _dispatch(self):
        selected_passes = _checked_paths(self.pass_list)
        if not selected_passes:
            hou.ui.displayMessage(
                "Select at least one render pass.",
                title="Render Dispatcher",
                severity=hou.severityType.Warning,
            )
            return
        passes_without_aovs = [
            path for path in selected_passes
            if not self.pass_aov_selections.get(path)
        ]
        if passes_without_aovs:
            names = {
                entry.path: entry.name for entry in self.preflight.passes
            }
            hou.ui.displayMessage(
                "These passes have no selected AOVs:\n{}".format(
                    "\n".join(names.get(path, path) for path in passes_without_aovs)
                ),
                title="Render Dispatcher",
                severity=hou.severityType.Warning,
            )
            return
        self._run_dispatch(selected_passes)

    def _run_dispatch(self, selected_passes):
        selected_aovs = sorted(set().union(*(
            self.pass_aov_selections.get(path, set()) for path in selected_passes
        )))
        self.dispatch_button.setEnabled(False)
        self.dispatch_button.setText("Submitting...")
        passes_by_path = {entry.path: entry for entry in self.preflight.passes}
        progress_entries = [
            passes_by_path[path] for path in selected_passes if path in passes_by_path
        ]
        self._progress_dialog = DispatchProgressDialog(
            progress_entries,
            parent=self,
            retry_callback=self._retry_paths,
        )
        self._progress_dialog.show()
        self._progress_dialog.raise_()
        QtWidgets.QApplication.processEvents()
        try:
            submitted = dispatch_to_deadline(
                self.node,
                selected_aovs=selected_aovs,
                selected_passes=selected_passes,
                frame_start=self.frame_start.value(),
                frame_end=self.frame_end.value(),
                priority=self.priority.value(),
                progress_callback=self._progress_dialog.update_progress,
                aovs_by_pass={
                    path: sorted(self.pass_aov_selections.get(path, set()))
                    for path in selected_passes
                },
            )
        except Exception as exc:
            _LOGGER.exception("Render dispatch failed")
            self._progress_dialog.mark_failed(str(exc))
        else:
            self._progress_dialog.finish()
        finally:
            self.dispatch_button.setText("Dispatch to Farm")
            self._update_validation()

    def _retry_paths(self, paths):
        if self._progress_dialog is not None:
            self._progress_dialog.close()
        self._run_dispatch(paths)


def show_dispatcher(node_or_kwargs=None):
    """Run preflight and open the dispatcher dialog."""
    if QtWidgets is None:
        raise RuntimeError("Qt is unavailable; cannot open Render Dispatcher.")
    node = _resolve_node(node_or_kwargs)
    if node is None:
        raise RuntimeError("Could not resolve the Render Dispatcher node.")
    parent = hou.qt.mainWindow() if hasattr(hou, "qt") else None
    dialog = RenderDispatcherDialog(node, parent=parent)
    dialog.show()
    hou.session.ayon_render_dispatcher_dialog = dialog
    return dialog


def preflight(kwargs=None):
    """HDA button callback."""
    return show_dispatcher(kwargs)


def open_ui(kwargs=None):
    """Backward-compatible alias for older callback experiments."""
    return show_dispatcher(kwargs)


def dispatch(kwargs=None):
    """Backward-compatible callback; preflight is mandatory before dispatch."""
    return show_dispatcher(kwargs)
