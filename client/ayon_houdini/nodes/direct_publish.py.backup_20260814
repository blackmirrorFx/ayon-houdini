_FRAME_TOKEN_PATTERN = re.compile(r"\$F(\d*)")
_MULTI_DOT_EXTENSIONS = (
    ".ass.gz",
    ".bgeo.sc",
    ".bgeo.gz",
    ".bgeo.lzma",
    ".bgeo.bz2",
)
_IMAGE_SEQUENCE_EXTENSIONS = {
    "jpg",
    "jpeg",
    "png",
    "bmp",
    "tif",
    "tiff",
    "tga",
    "exr",
}


def _normalize_path(path):
    return os.path.normpath(path).replace("\\", "/")


def _expand_houdini_path(path):
    try:
        import hou
    except Exception:
        return path

    try:
        return hou.expandString(path)
    except Exception:
        return path


def _expand_houdini_path_keep_frame_tokens(path):
    # Keep $F, $F4, ... unresolved while expanding variables like $HIP/$JOB.
    frame_tokens = []

    def _token_replacer(match):
        frame_tokens.append(match.group(0))
        return "__AYON_FRAME_TOKEN_{}__".format(len(frame_tokens) - 1)

    temp_path = _FRAME_TOKEN_PATTERN.sub(_token_replacer, path)
    expanded = _expand_houdini_path(temp_path)

    for index, token in enumerate(frame_tokens):
        expanded = expanded.replace(
            "__AYON_FRAME_TOKEN_{}__".format(index),
            token
        )
    return expanded


def resolve_publish_context(project_name=None, folder_path=None, task_name=None):
    if not project_name or not folder_path or not task_name:
        try:
            from ayon_core.pipeline import (
                get_current_context,
                get_current_project_name,
            )
        except Exception:
            get_current_context = None
            get_current_project_name = None

        if get_current_context:
            try:
                context = get_current_context() or {}
            except Exception:
                context = {}

            project_name = project_name or context.get("project_name")
            folder_path = folder_path or context.get("folder_path")
            task_name = task_name or context.get("task_name")

        if not project_name and get_current_project_name:
            try:
                project_name = get_current_project_name()
            except Exception:
                pass

    project_name = project_name or os.getenv("AYON_PROJECT_NAME")
    folder_path = folder_path or os.getenv("AYON_FOLDER_PATH")
    task_name = task_name or os.getenv("AYON_TASK_NAME")
    author = os.getenv("AYON_USERNAME") or os.getenv("USER")

    if not project_name:
        raise RuntimeError("Missing AYON project name in current context.")
    if not folder_path:
        raise RuntimeError("Missing AYON folder path in current context.")

    return {
        "project_name": project_name,
        "folder_path": folder_path,
        "task_name": task_name,
        "author": author,
    }


def _resolve_task_entity(project_name, folder_id, task_name):
    if not task_name:
        return None

    tasks = list(
        get_tasks(
            project_name=project_name,
            folder_ids=[folder_id],
        )
    )
    if not tasks:
        raise RuntimeError(
            "No tasks found under folder id '{}'.".format(folder_id)
        )

    lowered_name = task_name.lower()
    for task in tasks:
        if task["name"].lower() == lowered_name:
            return task

    for task in tasks:
        label = task.get("label") or ""
        if label.lower() == lowered_name:
            return task

    available = ", ".join(sorted(task["name"] for task in tasks))
    raise RuntimeError(
        "Task '{}' not found. Available tasks: {}".format(
            task_name, available
        )
    )


def _extract_extension(file_path):
    file_lower = file_path.lower()
    for extension in _MULTI_DOT_EXTENSIONS:
        if file_lower.endswith(extension):
            return extension.lstrip(".")
    return os.path.splitext(file_path)[1].lstrip(".").lower()


def _default_representation_name(product_type, extension):
    if not extension:
        return "main"

    if product_type == "review":
        return extension.split(".")[-1]

    if extension.startswith("bgeo."):
        return "bgeo"
    if extension in {"usda", "usdc"}:
        return "usd"

    return extension.split(".")[0]


def _coerce_version_number(value):
    if value is None:
        return None

    if isinstance(value, int):
        number = value
    else:
        text = str(value).strip().lower()
        if text.startswith("v"):
            text = text[1:]
        if not text.isdigit():
            raise RuntimeError(
                "Invalid version value '{}'. Use formats like v004 or 4.".format(
                    value
                )
            )
        number = int(text)

    if number < 1:
        raise RuntimeError("Version must be >= 1.")
    return number


def _list_sequence_files_from_folder(path_pattern):
    token_match = _FRAME_TOKEN_PATTERN.search(path_pattern)
    if not token_match:
        if os.path.exists(path_pattern):
            return [path_pattern]
        return []

    token = token_match.group(0)
    basename = os.path.basename(path_pattern)
    prefix, suffix = basename.split(token, 1)
    file_expr = re.compile(
        r"^{}(\d+){}$".format(re.escape(prefix), re.escape(suffix))
    )

    directory = os.path.dirname(path_pattern) or "."
    if not os.path.isdir(directory):
        return []

    output = []
    for filename in os.listdir(directory):
        if file_expr.match(filename):
            output.append(_normalize_path(os.path.join(directory, filename)))

    output.sort()
    return output


def collect_paths(path_or_paths, frame_start=None, frame_end=None):
    if isinstance(path_or_paths, (tuple, list, set)):
        expanded_paths = []
        for path in path_or_paths:
            expanded = _expand_houdini_path_keep_frame_tokens(path)
            expanded_paths.append(_normalize_path(expanded))
        existing = [path for path in expanded_paths if os.path.exists(path)]
        missing = [path for path in expanded_paths if not os.path.exists(path)]
        return existing, missing

    path_pattern = _normalize_path(
        _expand_houdini_path_keep_frame_tokens(path_or_paths)
    )
    match = _FRAME_TOKEN_PATTERN.search(path_pattern)
    if not match:
        if os.path.exists(path_pattern):
            return [path_pattern], []
        return [], [path_pattern]

    token = match.group(0)
    pad = int(match.group(1) or 1)
    if frame_start is not None and frame_end is not None:
        filepaths = []
        missing = []
        for frame in range(int(frame_start), int(frame_end) + 1):
            frame_path = path_pattern.replace(token, str(frame).zfill(pad))
            if os.path.exists(frame_path):
                filepaths.append(frame_path)
            else:
                missing.append(frame_path)
        return filepaths, missing

    filepaths = _list_sequence_files_from_folder(path_pattern)
    return filepaths, []


def _read_file_md5(path):
    hasher = hashlib.md5()
    with open(path, "rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            if not chunk:
                break
            hasher.update(chunk)
    return hasher.hexdigest()


def _project_root_candidates(project_name):
    output = []
    by_path = {}

    for key, value in os.environ.items():
        if not value:
            continue
        if key == "AYON_PROJECT_ROOT":
            norm = _normalize_path(value)
            by_path[norm] = "{root}"
            continue
        if key.startswith("AYON_PROJECT_ROOT_"):
            norm = _normalize_path(value)
            root_name = key[len("AYON_PROJECT_ROOT_"):].strip().lower()
            if root_name:
                by_path[norm] = "{{root[{0}]}}".format(root_name)
            else:
                by_path[norm] = "{root}"

    try:
        roots = get_project_roots_for_site(project_name=project_name) or {}
    except Exception:
        roots = {}

    for root_name, value in roots.items():
        if not value:
            continue
        norm = _normalize_path(value)
        if root_name:
            by_path[norm] = "{{root[{0}]}}".format(str(root_name))
        else:
            by_path[norm] = "{root}"

    for root_path in sorted(by_path.keys(), key=len, reverse=True):
        output.append((root_path, by_path[root_path]))
    return output


def _rootless_path(path, project_name, root_candidates=None):
    path = _normalize_path(path)
    if root_candidates is None:
        root_candidates = _project_root_candidates(project_name)

    for root_path, token in root_candidates:
        prefix = root_path.rstrip("/")
        if not prefix:
            continue
        if path == prefix:
            return token
        if path.startswith(prefix + "/"):
            rel = path[len(prefix):].lstrip("/")
            return "{}/{}".format(token, rel)
    return path


def _representation_files_payload(filepaths, project_name):
    root_candidates = _project_root_candidates(project_name)
    output = []
    for path in filepaths:
        norm_path = _normalize_path(path)
        payload = {
            "id": create_entity_id(),
            "name": os.path.basename(path),
            "path": _rootless_path(
                norm_path,
                project_name,
                root_candidates=root_candidates,
            ),
        }
        if os.path.exists(norm_path):
            payload["size"] = str(int(os.path.getsize(norm_path)))
            payload["hash"] = _read_file_md5(norm_path)
            payload["hashType"] = "md5"
        output.append(payload)
    return output


def _detect_numbered_sequence(filepaths):
    if not filepaths:
        return None

    first = _normalize_path(filepaths[0])
    directory = os.path.dirname(first)
    basename = os.path.basename(first)
    match = re.match(r"^(.*?)(\d+)(\.[^.]+)$", basename)
    if not match:
        return None

    prefix, frame_str, suffix = match.groups()
    pad = len(frame_str)
    frame_numbers = []

    for path in filepaths:
        name = os.path.basename(_normalize_path(path))
        item_match = re.match(
            r"^{}(\d{{{}}}){}$".format(
                re.escape(prefix),
                pad,
                re.escape(suffix),
            ),
            name,
        )
        if not item_match:
            return None
        frame_numbers.append(int(item_match.group(1)))

    frame_numbers = sorted(frame_numbers)
    return {
        "directory": directory,
        "prefix": prefix,
        "suffix": suffix,
        "padding": pad,
        "start_frame": frame_numbers[0],
        "end_frame": frame_numbers[-1],
    }


def _get_review_fps(default=24.0):
    try:
        import hou
    except Exception:
        return float(default)

    try:
        return float(hou.fps())
    except Exception:
        return float(default)


def _probe_media_resolution(path):
    try:
        cmd = get_ffmpeg_tool_args("ffprobe")
    except Exception:
        return None, None

    cmd.extend([
        "-v",
        "error",
        "-select_streams",
        "v:0",
        "-show_entries",
        "stream=width,height",
        "-of",
        "csv=s=x:p=0",
        path,
    ])
    result = subprocess.run(
        cmd,
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        return None, None

    output = (result.stdout or "").strip()
    if not output or "x" not in output:
        return None, None

    try:
        width_str, height_str = output.split("x", 1)
        return int(width_str), int(height_str)
    except Exception:
        return None, None


def _ensure_ayon_core_importable():
    try:
        import ayon_core  # noqa: F401
        return True
    except Exception:
        pass

    addons_dir = os.path.expanduser("~/.local/share/AYON/addons")
    for candidate in sorted(
        glob.glob(os.path.join(addons_dir, "core_*")),
        reverse=True,
    ):
        if not os.path.isdir(candidate):
            continue
        if candidate not in sys.path:
            sys.path.insert(0, candidate)
        try:
            import ayon_core  # noqa: F401
            return True
        except Exception:
            continue
    return False


def _get_task_type(task_entity):
    if not task_entity:
        return None
    return task_entity.get("taskType") or task_entity.get("type")


def _families_match(families, allowed_families):
    if not allowed_families:
        return True
    families_low = {
        str(family).strip().lower()
        for family in (families or [])
        if family
    }
    if not families_low:
        return False
    allowed_low = {
        str(family).strip().lower()
        for family in allowed_families
        if family
    }
    return bool(families_low & allowed_low)


def _tags_match(tags, allowed_tags):
    if not allowed_tags:
        return True
    tags_low = {
        str(tag).strip().lower()
        for tag in (tags or [])
        if tag
    }
    if not tags_low:
        return False
    allowed_low = {
        str(tag).strip().lower()
        for tag in allowed_tags
        if tag
    }
    return bool(tags_low & allowed_low)


def _extract_burnin_values_from_definition(burnin_def):
    positions = {
        "top_left",
        "top_centered",
        "top_right",
        "bottom_right",
        "bottom_centered",
        "bottom_left",
    }
    values = {}
    for key, value in (burnin_def or {}).items():
        key_low = str(key).lower()
        if key_low in positions and value:
            values[key_low] = value
    return values


def _select_ayon_burnin_values(profile, families, tags):
    burnin_defs = profile.get("burnins") or []
    for burnin_def in burnin_defs:
        definition_filter = burnin_def.get("filter") or {}
        if not _families_match(families, definition_filter.get("families")):
            continue
        if not _tags_match(tags, definition_filter.get("tags")):
            continue
        values = _extract_burnin_values_from_definition(burnin_def)
        if values:
            return values

    # Fallback to first definition with values even if filters don't match.
    for burnin_def in burnin_defs:
        values = _extract_burnin_values_from_definition(burnin_def)
        if values:
            return values
    return None


def _prepare_ayon_burnin_options(options_data=None):
    options = {
        "font_size": 42,
        "font_color": [255, 255, 255, 1.0],
        "bg_color": [0, 0, 0, 0.5],
        "bg_padding": 5,
        "x_offset": 5,
        "y_offset": 5,
    }
    for key, value in (options_data or {}).items():
        if value is not None:
            options[key] = copy.deepcopy(value)

    bg_color = options.get("bg_color")
    if bg_color and isinstance(bg_color, list) and len(bg_color) >= 4:
        bg_red, bg_green, bg_blue, bg_alpha = bg_color[:4]
        options["bg_color"] = "#{0:0>2X}{1:0>2X}{2:0>2X}".format(
            int(bg_red), int(bg_green), int(bg_blue)
        )
        options["bg_opacity"] = float(bg_alpha)

    font_color = options.get("font_color")
    if font_color and isinstance(font_color, list) and len(font_color) >= 4:
        fg_red, fg_green, fg_blue, fg_alpha = font_color[:4]
        options["font_color"] = "#{0:0>2X}{1:0>2X}{2:0>2X}".format(
            int(fg_red), int(fg_green), int(fg_blue)
        )
        options["opacity"] = float(fg_alpha)

    font_filepath = options.get("font_filepath")
    if isinstance(font_filepath, dict):
        font_filepath = font_filepath.get(platform.system().lower())
    if isinstance(font_filepath, str):
        try:
            font_filepath = font_filepath.format(**os.environ)
        except Exception:
            pass
        if not os.path.exists(font_filepath):
            font_filepath = None

    if not font_filepath:
        try:
            from ayon_core import resources
            font_filepath = resources.get_liberation_font_path()
        except Exception:
            font_filepath = None
    if font_filepath:
        options["font"] = _normalize_path(font_filepath)
    return options


def _build_ayon_burnin_data(context_data, sequence_info):
    frame_start = int(context_data.get("frame_start") or sequence_info["start_frame"])
    frame_end = int(context_data.get("frame_end") or sequence_info["end_frame"])
    duration = max(1, frame_end - frame_start + 1)
    fps = float(context_data.get("fps") or _get_review_fps(default=24.0))

    folder_path = context_data.get("folder_path") or ""
    folder_parts = [part for part in folder_path.split("/") if part]
    folder_name = folder_parts[-1] if folder_parts else ""
    hierarchy = "/".join(folder_parts[:-1]) if len(folder_parts) > 1 else ""
    task_name = context_data.get("task_name") or ""
    task_type = context_data.get("task_type") or ""
    author = context_data.get("author") or os.getenv("AYON_USERNAME") or os.getenv("USER") or ""

    burnin_data = {
        "project": {
            "name": context_data.get("project_name") or "",
            "code": context_data.get("project_name") or "",
        },
        "folder": {
            "path": folder_path,
            "name": folder_name,
        },
        "asset": folder_name,
        "hierarchy": hierarchy,
        "task": {
            "name": task_name,
            "type": task_type,
        },
        "product": {
            "name": context_data.get("product_name") or "",
            "type": context_data.get("product_type") or "review",
        },
        "representation": "mp4",
        "version": int(context_data.get("version") or 1),
        "comment": "",
        "intent": "",
        "frame_start": frame_start,
        "frame_end": frame_end,
        "duration": duration,
        "slate_frame_start": frame_start,
        "slate_frame_end": frame_end,
        "slate_duration": duration,
        "fps": fps,
        "user": author,
        "username": author,
        "host": context_data.get("host_name") or "houdini",
    }

    try:
        from ayon_core.pipeline import Anatomy

        anatomy = Anatomy(context_data.get("project_name"))
        filled = anatomy.format_all(copy.deepcopy(burnin_data))
        solved = filled.get_solved()
        if solved:
            burnin_data["anatomy"] = solved
    except Exception:
        pass

    return burnin_data


def _apply_ayon_default_burnin(input_path, output_path, context_data, sequence_info):
    if not _ensure_ayon_core_importable():
        raise RuntimeError("Unable to import ayon_core.")

    from ayon_core.settings import get_project_settings
    from ayon_core.lib.profiles_filtering import filter_profiles
    from ayon_core.scripts.otio_burnin import burnins_from_data

    project_name = context_data.get("project_name")
    if not project_name:
        raise RuntimeError("Missing project name for AYON burnin settings.")

    project_settings = get_project_settings(project_name)
    burnin_settings = (
        project_settings
        .get("core", {})
        .get("publish", {})
        .get("ExtractBurnin", {})
    )
    profiles = burnin_settings.get("profiles") or []
    if not profiles:
        raise RuntimeError("No ExtractBurnin profiles are configured.")

    host_name = context_data.get("host_name") or os.getenv("AYON_HOST_NAME") or "houdini"
    criteria = {
        "hosts": host_name,
        "product_types": context_data.get("product_type") or "review",
        "product_names": context_data.get("product_name") or "",
        "task_names": context_data.get("task_name") or "",
        "task_types": context_data.get("task_type") or "",
    }
    profile = filter_profiles(profiles, criteria)
    if not profile:
        raise RuntimeError(
            "No ExtractBurnin profile matched host/product/task context."
        )

    burnin_values = _select_ayon_burnin_values(
        profile=profile,
        families=["review"],
        tags=["burnin", "webreview", "review"],
    )
    if not burnin_values:
        raise RuntimeError("No burnin definition matched current review output.")

    burnin_options = _prepare_ayon_burnin_options(
        burnin_settings.get("options") or {}
    )
    burnin_data = _build_ayon_burnin_data(context_data, sequence_info)

    burnins_from_data(
        input_path=_normalize_path(input_path),
        output_path=_normalize_path(output_path),
        data=burnin_data,
        options=burnin_options,
        burnin_values=burnin_values,
        overwrite=True,
        full_input_path=_normalize_path(input_path),
        first_frame=sequence_info["start_frame"],
    )

    if not os.path.exists(output_path):
        raise RuntimeError("AYON burnin did not generate output file.")


def _get_direct_publish_burnin_mode():
    # 'custom' uses the styled overlay in this module.
    # 'ayon' uses AYON project settings from ExtractBurnin.
    # 'auto' tries AYON first then falls back to custom.
    # 'none' skips burnin and uploads clean mp4.
    mode = (os.getenv("AYON_DIRECT_PUBLISH_BURNIN_MODE") or "custom").strip().lower()
    if mode not in {"custom", "ayon", "auto", "none"}:
        return "custom"
    return mode


def _truncate_text(value, max_length=120):
    text = str(value or "")
    if len(text) <= max_length:
        return text
    return text[: max_length - 3] + "..."


def _escape_drawtext_value(value, escape_percent=True):
    text = str(value or "")
    text = text.replace("\\", "\\\\")
    text = text.replace(":", r"\:")
    text = text.replace("'", r"\'")
    text = text.replace(",", r"\,")
    text = text.replace("[", r"\[")
    text = text.replace("]", r"\]")
    if escape_percent:
        text = text.replace("%", r"\%")
    return text


def _get_burnin_font_path():
    env_font = os.getenv("AYON_BURNIN_FONT")
    if env_font and os.path.exists(env_font):
        return _normalize_path(env_font)

    try:
        result = subprocess.run(
            ["fc-match", "-f", "%{file}\n", "sans"],
            capture_output=True,
            text=True,
            check=False,
        )
        font_path = (result.stdout or "").strip()
        if result.returncode == 0 and font_path and os.path.exists(font_path):
            return _normalize_path(font_path)
    except Exception:
        pass

    candidates = [
        "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
        "/usr/share/fonts/dejavu/DejaVuSans.ttf",
        "/usr/share/fonts/liberation/LiberationSans-Regular.ttf",
    ]
    for path in candidates:
        if os.path.exists(path):
            return _normalize_path(path)
    return None


def _drawtext_filter(
    text,
    x,
    y,
    font_size=20,
    font_path=None,
    escape_text=True,
    font_color="white",
    opacity=0.98,
    border_width=1.2,
    border_color="black@0.85",
):
    prefix = "drawtext="
    if font_path:
        prefix += "fontfile='{}':".format(
            _escape_drawtext_value(font_path, escape_percent=False)
        )
    if escape_text:
        text = _escape_drawtext_value(text)
    else:
        # Keep ffmpeg expressions like %{eif\:...} intact.
        text = str(text or "").replace("'", r"\'").replace(",", r"\,")
    return (
        (
            "{}text='{}':x={}:y={}:fontsize={}"
            ":fontcolor={}@{}:borderw={}:bordercolor={}"
        ).format(
            prefix,
            text,
            x,
            y,
            int(font_size),
            font_color,
            float(opacity),
            float(border_width),
            border_color,
        )
    )


def _default_reviewable_encode_args(encode_profile="hq"):
    # Keep this close to AYON publish defaults for review outputs:
    # h264/yuv420p + faststart + all-intra GOP.
    profile = str(encode_profile or "hq").strip().lower()
    if profile in {"fast", "preview"}:
        return [
            "-c:v",
            "libx264",
            "-preset",
            "veryfast",
            "-crf",
            "24",
            "-pix_fmt",
            "yuv420p",
            "-g",
            "12",
            "-movflags",
            "+faststart",
            "-an",
        ]

    return [
        "-c:v",
        "libx264",
        "-crf",
        "18",
        "-pix_fmt",
        "yuv420p",
        "-g",
        "1",
        "-movflags",
        "+faststart",
        "-an",
    ]


def _build_burnin_filter_graph(context_data, sequence_info):
    burnin_preset = str(context_data.get("burnin_preset") or "compact").strip().lower()
    version = int(context_data.get("version") or 1)
    author = _truncate_text(context_data.get("author"), 32)
    folder_path = context_data.get("folder_path") or ""
    folder_parts = [part for part in folder_path.split("/") if part]
    shot_name = context_data.get("shot_name") or ""
    if not shot_name:
        shot_name = folder_parts[-1] if folder_parts else ""
    if not shot_name:
        shot_name = context_data.get("product_name") or "review"

    top_left = datetime.now().strftime("%y-%m-%d")
    top_right = "v{:03d}".format(version)
    bottom_left = author or "unknown"
    bottom_center = _truncate_text(shot_name, 48)
    bottom_right = "{}-%{{eif\\:n+{}\\:d}}-{}".format(
        sequence_info["start_frame"],
        sequence_info["start_frame"],
        sequence_info["end_frame"],
    )
    product_name = _truncate_text(context_data.get("product_name"), 48)
    task_name = _truncate_text(context_data.get("task_name"), 24)
    project_name = _truncate_text(context_data.get("project_name"), 32)
    fps_text = "{:.2f}fps".format(float(context_data.get("fps") or 24.0))
    if burnin_preset == "detailed":
        top_left = _truncate_text(
            "{} | {} | {}".format(project_name, shot_name, task_name),
            80,
        )
        bottom_center = product_name or bottom_center
        bottom_left = _truncate_text("{} | {}".format(bottom_left, fps_text), 64)
    elif burnin_preset == "minimal":
        bottom_left = ""
        bottom_center = _truncate_text(shot_name, 64)
    elif burnin_preset == "compact":
        pass
    else:
        # Unknown preset -> default compact layout.
        burnin_preset = "compact"

    resolution_height = int(context_data.get("resolution_height") or 1080)
    bar_height = max(30, int(round(resolution_height * 0.032)))
    if bar_height % 2 != 0:
        bar_height += 1

    font_size = max(15, int(round(bar_height * 0.44)))
    margin_x = max(12, int(round(bar_height * 0.35)))
    top_y = max(4, int(round((bar_height - font_size) / 2.0)))
    bottom_y = "h-{}+{}".format(bar_height, top_y)
    padded_height_expr = "ceil((ih+{})/2)*2".format(bar_height * 2)

    font_path = _get_burnin_font_path()
    filters = [
        # Add extra canvas above/below original image so burnins do not cover it.
        "pad=ceil(iw/2)*2:{}:0:{}:black".format(
            padded_height_expr,
            bar_height
        ),
        "drawbox=x=0:y=0:w=iw:h={}:color=black@0.96:t=fill".format(
            bar_height
        ),
        "drawbox=x=0:y=ih-{}:w=iw:h={}:color=black@0.96:t=fill".format(
            bar_height,
            bar_height,
        ),
        _drawtext_filter(
            text=top_left,
            x=str(margin_x),
            y=str(top_y),
            font_size=font_size,
            font_path=font_path,
        ),
        _drawtext_filter(
            text=top_right,
            x="w-tw-{}".format(margin_x),
            y=str(top_y),
            font_size=font_size,
            font_path=font_path,
        ),
    ]
    if bottom_left:
        filters.append(
            _drawtext_filter(
                text=bottom_left,
                x=str(margin_x),
                y=bottom_y,
                font_size=font_size,
                font_path=font_path,
            )
        )
    filters.extend([
        _drawtext_filter(
            text=bottom_center,
            x="(w-tw)/2",
            y=bottom_y,
            font_size=font_size,
            font_path=font_path,
        ),
        _drawtext_filter(
            text=bottom_right,
            x="w-tw-{}".format(margin_x),
            y=bottom_y,
            font_size=font_size,
            font_path=font_path,
            escape_text=False,
        ),
    ])
    return ",".join(filters)


def _encode_sequence_to_mp4(
    input_pattern,
    start_frame,
    fps,
    output_path,
    filter_graph=None,
    encode_profile="hq",
):
    cmd = get_ffmpeg_tool_args("ffmpeg")
    cmd.extend([
        "-y",
        "-loglevel",
        "error",
        "-framerate",
        str(float(fps)),
        "-start_number",
        str(int(start_frame)),
        "-i",
        input_pattern,
        "-map",
        "0:v:0",
    ])

    if filter_graph:
        cmd.extend(["-vf", filter_graph])
    else:
        # Keep dimensions even for codecs like h264.
        cmd.extend(["-vf", "pad=ceil(iw/2)*2:ceil(ih/2)*2"])

    cmd.extend([
        "-map_metadata",
        "-1",
        "-map_chapters",
        "-1",
        "-dn",
        "-sn",
    ])
    cmd.extend(_default_reviewable_encode_args(encode_profile=encode_profile))
    cmd.append(output_path)

    result = subprocess.run(
        cmd,
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode != 0 or not os.path.exists(output_path):
        err = (result.stderr or result.stdout or "Unknown ffmpeg error").strip()
        raise RuntimeError(err)


def _apply_custom_burnin_to_video(
    input_video_path,
    output_path,
    context_data,
    sequence_info,
    encode_profile="hq",
):
    filter_graph = _build_burnin_filter_graph(context_data, sequence_info)
    cmd = get_ffmpeg_tool_args("ffmpeg")
    cmd.extend([
        "-y",
        "-loglevel",
        "error",
        "-i",
        input_video_path,
        "-map",
        "0:v:0",
        "-vf",
        filter_graph,
    ])
    cmd.extend([
        "-map_metadata",
        "-1",
        "-map_chapters",
        "-1",
        "-dn",
        "-sn",
    ])
    cmd.extend(_default_reviewable_encode_args(encode_profile=encode_profile))
    cmd.append(output_path)
    result = subprocess.run(
        cmd,
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode != 0 or not os.path.exists(output_path):
        err = (result.stderr or result.stdout or "Unknown ffmpeg error").strip()
        raise RuntimeError(err)


def _create_reviewable_video_from_sequence(
    filepaths,
    product_name,
    version_number,
    context_data=None,
    burnin_mode=None,
    encode_profile=None,
    burnin_preset=None,
):
    try:
        get_ffmpeg_tool_args("ffmpeg")
    except Exception as exc:
        raise RuntimeError(
            "FFmpeg could not be resolved through AYON. "
            "Cannot create video from review sequence."
        ) from exc

    sequence_info = _detect_numbered_sequence(filepaths)
    if not sequence_info:
        raise RuntimeError(
            "Cannot detect numbered image sequence for online reviewable upload."
        )

    output_dir = sequence_info["directory"]
    os.makedirs(output_dir, exist_ok=True)
    output_basename = "{}_v{:03d}".format(product_name, int(version_number))
    output_path = os.path.join(
        output_dir,
        "{}.mp4".format(output_basename),
    )
    source_video_path = os.path.join(
        output_dir,
        "{}.source.mp4".format(output_basename),
    )

    input_pattern = os.path.join(
        sequence_info["directory"],
        "{}%0{}d{}".format(
            sequence_info["prefix"],
            sequence_info["padding"],
            sequence_info["suffix"],
        ),
    )

    if context_data is None:
        context_data = {}
    context_data = dict(context_data)
    context_data.setdefault("product_name", product_name)
    context_data.setdefault("product_type", "review")
    context_data.setdefault("version", version_number)
    context_data.setdefault("frame_start", sequence_info["start_frame"])
    context_data.setdefault("frame_end", sequence_info["end_frame"])
    context_data.setdefault("host_name", "houdini")
    context_data.setdefault("fps", _get_review_fps(default=24.0))
    context_data.setdefault("burnin_preset", burnin_preset or "compact")
    context_data.setdefault("encode_profile", encode_profile or "hq")

    if burnin_mode is None:
        burnin_mode = _get_direct_publish_burnin_mode()
    burnin_mode = str(burnin_mode or "custom").strip().lower()
    if burnin_mode not in {"custom", "ayon", "auto", "none"}:
        burnin_mode = "custom"

    encode_profile = str(
        context_data.get("encode_profile") or encode_profile or "hq"
    ).strip().lower()

    try:
        _encode_sequence_to_mp4(
            input_pattern=input_pattern,
            start_frame=sequence_info["start_frame"],
            fps=context_data["fps"],
            output_path=source_video_path,
            filter_graph=None,
            encode_profile=encode_profile,
        )
    except Exception as exc:
        raise RuntimeError(
            "Failed to create reviewable mp4 from sequence: {}".format(exc)
        ) from exc

    source_width, source_height = _probe_media_resolution(source_video_path)
    if source_width:
        context_data.setdefault("resolution_width", source_width)
    if source_height:
        context_data.setdefault("resolution_height", source_height)

    burnin_error = None

    if burnin_mode == "none":
        shutil.copy2(source_video_path, output_path)

    elif burnin_mode == "custom":
        try:
            _apply_custom_burnin_to_video(
                input_video_path=source_video_path,
                output_path=output_path,
                context_data=context_data,
                sequence_info=sequence_info,
                encode_profile=encode_profile,
            )
        except Exception as exc:
            burnin_error = str(exc)
            shutil.copy2(source_video_path, output_path)

    elif burnin_mode == "ayon":
        try:
            _apply_ayon_default_burnin(
                input_path=source_video_path,
                output_path=output_path,
                context_data=context_data,
                sequence_info=sequence_info,
            )
        except Exception as exc:
            burnin_error = str(exc)
            raise RuntimeError(
                "AYON burnin failed in 'ayon' mode: {}".format(burnin_error)
            ) from exc

    else:
        # auto
        try:
            _apply_ayon_default_burnin(
                input_path=source_video_path,
                output_path=output_path,
                context_data=context_data,
                sequence_info=sequence_info,
            )
        except Exception as exc:
            burnin_error = str(exc)
            try:
                _apply_custom_burnin_to_video(
                    input_video_path=source_video_path,
                    output_path=output_path,
                    context_data=context_data,
                    sequence_info=sequence_info,
                    encode_profile=encode_profile,
                )
            except Exception:
                burnin_error = (
                    "{} | custom fallback failed".format(burnin_error)
                )
                shutil.copy2(source_video_path, output_path)

    if not os.path.exists(output_path):
        if burnin_mode == "ayon" and burnin_error:
            raise RuntimeError(
                "Failed to generate AYON burnin reviewable mp4: {}".format(
                    burnin_error
                )
            )
        if os.path.exists(source_video_path):
            shutil.copy2(source_video_path, output_path)

    if os.path.exists(source_video_path):
        try:
            os.remove(source_video_path)
        except Exception:
            pass

    if not os.path.exists(output_path):
        if burnin_error and burnin_mode != "none":
            raise RuntimeError(
                "Failed to generate burnin reviewable mp4: {}".format(
                    burnin_error
                )
            )
        raise RuntimeError("Failed to generate reviewable mp4.")

    return _normalize_path(output_path)


def _pick_online_reviewable_file(
    result,
    burnin_mode=None,
    encode_profile=None,
    burnin_preset=None,
):
    files = result["files"]
    if not files:
        raise RuntimeError("No published files found for online review upload.")

    if len(files) == 1:
        return files[0]

    ext = _extract_extension(files[0]).lower()
    if ext in _IMAGE_SEQUENCE_EXTENSIONS:
        return _create_reviewable_video_from_sequence(
            filepaths=files,
            product_name=result["product_name"],
            version_number=result["version"],
            context_data=result,
            burnin_mode=burnin_mode,
            encode_profile=encode_profile,
            burnin_preset=burnin_preset,
        )

    return files[0]


def _merge_unique_tags(base_tags, extra_tags):
    output = []
    seen = set()
    for source in (base_tags or [], extra_tags or []):
        for item in source:
            value = str(item or "").strip()
            if not value:
                continue
            key = value.lower()
            if key in seen:
                continue
            seen.add(key)
            output.append(value)
    return output


def upload_online_reviewable_for_result(
    result,
    reviewable_label=None,
    burnin_mode=None,
    encode_profile=None,
    burnin_preset=None,
    raise_on_error=True,
):
    reviewable_path = _pick_online_reviewable_file(
        result,
        burnin_mode=burnin_mode,
        encode_profile=encode_profile,
        burnin_preset=burnin_preset,
    )
    label = reviewable_label or "{}_v{:03d}".format(
        result["product_name"],
        int(result["version"]),
    )
    try:
        response = upload_reviewable(
            project_name=result["project_name"],
            version_id=result["version_id"],
            filepath=reviewable_path,
            label=label,
            filename=os.path.basename(reviewable_path),
        )
        if getattr(response, "status_code", 200) >= 400:
            raise RuntimeError(str(getattr(response, "text", response)))
    except Exception as exc:
        if raise_on_error:
            raise RuntimeError(
                "Published representation, but failed to upload online reviewable: "
                "{}".format(exc)
            ) from exc
        result["upload_error"] = str(exc)
        result["online_reviewable_file"] = reviewable_path
        result["reviewable_label"] = label
        return result

    result["online_reviewable_file"] = reviewable_path
    result["reviewable_label"] = label
    result["upload_error"] = None
    return result


def publish_files(
    product_name,
    product_type,
    path_or_paths,
    representation_name=None,
    frame_start=None,
    frame_end=None,
    project_name=None,
    folder_path=None,
    task_name=None,
    author=None,
    version=None,
    version_data=None,
    version_attrib=None,
    version_tags=None,
    version_status=None,
    allow_version_fallback=False,
    representation_data=None,
    representation_tags=None,
    representation_attrib=None,
):
    if not product_name:
        raise RuntimeError("Product name cannot be empty.")
    if not product_type:
        raise RuntimeError("Product type cannot be empty.")

    context = resolve_publish_context(
        project_name=project_name,
        folder_path=folder_path,
        task_name=task_name,
    )
    project_name = context["project_name"]
    folder_path = context["folder_path"]
    task_name = context["task_name"]
    if not author:
        author = context["author"]

    folder = get_folder_by_path(
        project_name=project_name,
        folder_path=folder_path,
    )
    if not folder:
        raise RuntimeError(
            "Folder '{}' not found in AYON.".format(folder_path)
        )
    folder_id = folder["id"]

    task_entity = _resolve_task_entity(project_name, folder_id, task_name)
    task_id = task_entity["id"] if task_entity else None
    task_name = task_entity["name"] if task_entity else task_name
    task_type = _get_task_type(task_entity)

    product = get_product_by_name(
        project_name=project_name,
        product_name=product_name,
        folder_id=folder_id,
    )
    if product:
        product_id = product["id"]
    else:
        product_id = create_product(
            project_name=project_name,
            name=product_name,
            product_type=product_type,
            folder_id=folder_id,
        )

    last_version = get_last_version_by_product_id(
        project_name=project_name,
        product_id=product_id,
    )
    requested_version = _coerce_version_number(version)
    if requested_version is None:
        version_number = 1
        if last_version:
            version_number = int(last_version["version"]) + 1
    else:
        version_number = int(requested_version)
        if last_version:
            last_number = int(last_version["version"])
            if last_number >= version_number:
                if allow_version_fallback:
                    version_number = last_number + 1
                else:
                    raise RuntimeError(
                        "Requested version v{:03d} is not available. "
                        "Latest existing version is v{:03d}.".format(
                            version_number,
                            last_number,
                        )
                    )

    version_id = create_version(
        project_name=project_name,
        product_id=product_id,
        version=version_number,
        task_id=task_id,
        author=author,
        attrib=version_attrib,
        data=version_data,
        tags=version_tags,
        status=version_status,
    )

    filepaths, missing_paths = collect_paths(
        path_or_paths=path_or_paths,
        frame_start=frame_start,
        frame_end=frame_end,
    )
    if missing_paths:
        preview = ", ".join(missing_paths[:3])
        if len(missing_paths) > 3:
            preview += " ..."
        raise RuntimeError(
            "Missing published files ({}): {}".format(
                len(missing_paths), preview
            )
        )
    if not filepaths:
        raise RuntimeError("No files found to publish.")

    extension = _extract_extension(filepaths[0])
    if not representation_name:
        representation_name = _default_representation_name(
            product_type, extension
        )

    final_representation_attrib = {
        "path": _rootless_path(_normalize_path(filepaths[0]), project_name)
    }
    if representation_attrib:
        final_representation_attrib.update(representation_attrib)

    final_representation_data = dict(representation_data or {})
    if frame_start is not None:
        final_representation_data.setdefault("frameStart", int(frame_start))
    if frame_end is not None:
        final_representation_data.setdefault("frameEnd", int(frame_end))
    if len(filepaths) > 1:
        final_representation_data.setdefault("sequence", True)

    try:
        representation_id = create_representation(
            project_name=project_name,
            name=representation_name,
            version_id=version_id,
            files=_representation_files_payload(filepaths, project_name),
            attrib=final_representation_attrib,
            data=final_representation_data,
            tags=representation_tags,
        )
    except Exception as exc:
        detail = getattr(exc, "response", None)
        if detail is not None:
            try:
                detail_text = detail.text
            except Exception:
                detail_text = str(detail)
            raise RuntimeError(
                "Representation creation failed: {}".format(detail_text)
            ) from exc
        raise

    return {
        "project_name": project_name,
        "folder_path": folder_path,
        "task_name": task_name,
        "task_type": task_type,
        "host_name": os.getenv("AYON_HOST_NAME") or "houdini",
        "author": author,
        "product_name": product_name,
        "product_type": product_type,
        "product_id": product_id,
        "version": version_number,
        "version_id": version_id,
        "representation_name": representation_name,
        "representation_id": representation_id,
        "frame_start": frame_start,
        "frame_end": frame_end,
        "files": filepaths,
    }


def publish_review_sequence(
    product_name,
    path_or_paths,
    frame_start=None,
    frame_end=None,
    representation_name=None,
    project_name=None,
    folder_path=None,
    task_name=None,
    author=None,
    version=None,
    version_data=None,
    version_attrib=None,
    version_tags=None,
    version_status=None,
    representation_data=None,
    representation_tags=None,
    representation_attrib=None,
    reviewable_label=None,
    create_online_reviewable=True,
    burnin_mode=None,
    encode_profile=None,
    burnin_preset=None,
    raise_on_upload_error=True,
    allow_version_fallback=False,
):
    merged_representation_data = {"preview": True}
    if representation_data:
        merged_representation_data.update(representation_data)

    result = publish_files(
        product_name=product_name,
        product_type="review",
        path_or_paths=path_or_paths,
        frame_start=frame_start,
        frame_end=frame_end,
        representation_name=representation_name,
        project_name=project_name,
        folder_path=folder_path,
        task_name=task_name,
        author=author,
        version=version,
        version_data=version_data,
        version_attrib=version_attrib,
        version_tags=version_tags,
        version_status=version_status,
        allow_version_fallback=allow_version_fallback,
        representation_tags=_merge_unique_tags(["review"], representation_tags),
        representation_data=merged_representation_data,
        representation_attrib=representation_attrib,
    )

    if not create_online_reviewable:
        result["online_reviewable_file"] = None
        result["reviewable_label"] = reviewable_label
        result["upload_error"] = None
        result["reviewable_skipped"] = True
        return result

    result = upload_online_reviewable_for_result(
        result=result,
        reviewable_label=reviewable_label,
        burnin_mode=burnin_mode,
        encode_profile=encode_profile,
        burnin_preset=burnin_preset,
        raise_on_error=raise_on_upload_error,
    )
    result["reviewable_skipped"] = False
    return result


def publish_pointcache(
    product_name,
    path_or_paths,
    frame_start=None,
    frame_end=None,
    representation_name=None,
    project_name=None,
    folder_path=None,
    task_name=None,
    author=None,
    version=None,
):
    return publish_files(
        product_name=product_name,
        product_type="pointcache",
        path_or_paths=path_or_paths,
        frame_start=frame_start,
        frame_end=frame_end,
        representation_name=representation_name,
        project_name=project_name,
        folder_path=folder_path,
        task_name=task_name,
        author=author,
        version=version,
    )
